{
  "name": "momo-tool-studio",
  "private": true,
  "version": "0.7.10",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-native.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac zip --arm64",
    "configure-account": "node scripts/configure-account.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "opencode-ai": "1.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0"
  },
  "productName": "Momo 小作坊",
  "description": "用自然语言制作本机小工具的桌面工作台",
  "author": "Momo Studio",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.momo.toolstudio",
    "productName": "Momo 小作坊",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/assets/momo.png",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/opencode-*/**/*",
      "node_modules/opencode-ai/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "build/momo-observer",
        "to": "momo-observer"
      }
    ]
  }
}
